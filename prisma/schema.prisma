// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma v7: URL quản lý hoàn toàn bởi prisma.config.ts (datasource.url)
  // KHÔNG đặt url ở đây khi đã có prisma.config.ts
}

// ---------------------------------------------------------------------------
// Event — Sự kiện / chuyến đi / nhóm chia tiền
// ---------------------------------------------------------------------------
model Event {
  id                 String   @id @default(uuid())
  title              String
  /// Tiền tệ gốc của sự kiện (ISO 4217). Đổi tỪn từ `currency` — dùng RENAME COLUMN trong migration, không DROP+ADD
  baseCurrency       String   @default("VND")
  /// DeviceToken của người tạo event — soft identity, dùng để kiểm tra quyền đổi baseCurrency
  creatorDeviceToken String?
  /// Chế độ nâng cao (có quản lý ngân sách / quyết toán bù trừ)
  isAdvancedMode     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  participants Participant[]
  expenses     Expense[]
  settlements  Settlement[]
  groups       Group[]
}

// ---------------------------------------------------------------------------
// Participant — Thành viên tham gia sự kiện
// ---------------------------------------------------------------------------
enum BudgetMode {
  FIXED
  UNLIMITED
  SELF_FUNDED
}

model Participant {
  id          String   @id @default(cuid())
  eventId     String
  userId      String? // Để trống nếu là khách không đăng nhập (Phase 3)
  name        String
  /// Token ẩn danh gắn vào thiết bị khi chọn tên lần đầu.
  /// Unique để 1 token chỉ map 1 participant.
  /// Dùng để xác thực "soft identity" mà không cần đăng nhập.
  deviceToken String?
  /// Chế độ ngân sách của thành viên
  budgetMode  BudgetMode @default(FIXED)
  /// Ngân sách cố định (chỉ có ý nghĩa khi budgetMode = FIXED)
  budget      Int        @default(0)
  
  /// Hệ số (weight) để tính toán tự động khi chia theo phần
  weight       Float @default(1.0)
  /// Cấu hình gia đình dạng { adults: number, children: number[] }
  familyConfig Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paymentInfo PaymentInfo? // 1-1, optional
  user        User?        @relation(fields: [userId], references: [id])

  paidExpenses        Expense[]      @relation("PaidBy")
  createdExpenses     Expense[]      @relation("CreatedBy")
  owedSplits          ExpenseSplit[]
  settlementsSent     Settlement[]   @relation("SettlementFrom")
  settlementsReceived Settlement[]   @relation("SettlementTo")
  groupMembers        GroupMember[]

  @@unique([eventId, deviceToken])
  @@index([eventId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// PaymentInfo — Thông tin thanh toán (1-1 với Participant)
// ---------------------------------------------------------------------------
model PaymentInfo {
  id            String @id @default(cuid())
  participantId String @unique // 1-1: mỗi participant chỉ có 1 payment info

  // VietQR (Việt Nam)
  bankBIN       String? // mã ngân hàng theo chuẩn VietQR
  accountNumber String?
  accountName   String?

  // PayPay (Nhật) — để dành cho task ngày mai, KHÔNG code phần này hôm nay
  paypayLink String?

  updatedAt DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Expense — Khoản chi tiêu
// ---------------------------------------------------------------------------
enum SplitMode {
  AMOUNT
  SHARES
}

model Expense {
  id               String   @id @default(cuid())
  eventId          String
  title            String
  /// Số tiền đã quy đổi sang baseCurrency của event — KHÔNG dùng Float để tránh sai số
  amount           Int
  payerId          String
  /// Participant đã tạo khoản chi — để hiển thị "ai đã thêm", không dùng để chặn cứng
  createdById      String?
  /// Tiền tệ gốc của khoản chi (nếu khác baseCurrency của event)
  originalCurrency String?
  /// Tỷ giá snapshot tại thời điểm tạo/sửa — dùng Decimal để tránh sai số dấu phẩy động
  exchangeRate     Decimal?  @db.Decimal(18, 6)
  /// Đánh dấu Expense do thuật toán bù đắp chéo tự sinh — dùng để xác định và xóa/tạo lại khi re-apply
  isCrossSubsidy   Boolean  @default(false)
  /// Ngày phát sinh khoản chi
  expenseDate      DateTime @default(now())
  /// Chế độ chia tiền
  splitMode        SplitMode @default(AMOUNT)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// Optimistic locking — tăng mỗi lần update để tránh 2 người ghi đè nhau
  version          Int      @default(0)

  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payer     Participant    @relation("PaidBy", fields: [payerId], references: [id])
  createdBy Participant?   @relation("CreatedBy", fields: [createdById], references: [id])
  splits    ExpenseSplit[]

  @@index([eventId])
  @@index([payerId])
}

// ---------------------------------------------------------------------------
// ExpenseSplit — Phân bổ chi phí cho từng thành viên trong 1 khoản chi
// ---------------------------------------------------------------------------
model ExpenseSplit {
  id            String @id @default(cuid())
  expenseId     String
  participantId String
  /// Số tiền participant này phải chịu — đơn vị đồng (VND)
  amount        Int

  expense     Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// Ràng buộc: 1 participant chỉ xuất hiện đúng 1 lần trong 1 khoản chi
  @@unique([expenseId, participantId])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Settlement — Ghi nhận thanh toán nợ thực tế + trạng thái xác nhận 2 chiều
// ---------------------------------------------------------------------------
model Settlement {
  id          String           @id @default(cuid())
  eventId     String
  /// fromId: người trả nợ (con nợ — A)
  fromId      String
  /// toId: người nhận nợ (chủ nợ — B)
  toId        String
  /// Số tiền cần chuyển — đơn vị đồng
  amount      Int
  status      SettlementStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  /// Thời điểm B xác nhận đã nhận — chỉ set khi status = CONFIRMED
  confirmedAt DateTime?

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  from  Participant @relation("SettlementFrom", fields: [fromId], references: [id])
  to    Participant @relation("SettlementTo", fields: [toId], references: [id])

  @@index([eventId])
  @@index([fromId])
  @@index([toId])
}

// ---------------------------------------------------------------------------
// Enum: Trạng thái thanh toán — xác nhận bắt buộc từ CẢ 2 phía
// ---------------------------------------------------------------------------
enum SettlementStatus {
  /// Chưa ai bấm gì
  PENDING
  /// A (người nợ) đã bấm "Đã chuyển tiền" — chờ B xác nhận
  MARKED_PAID
  /// B (người nhận) đã bấm "Đã nhận được" — khoản nợ coi như xong
  CONFIRMED
}

// ---------------------------------------------------------------------------
// NextAuth / Auth.js Models (Phase 3)
// ---------------------------------------------------------------------------

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  participants  Participant[] // Một user có thể join nhiều events

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Group & GroupMember — Tag nhóm Flex-Split
// ---------------------------------------------------------------------------
model Group {
  id        String        @id @default(cuid())
  eventId   String
  name      String
  createdAt DateTime      @default(now())
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members   GroupMember[]
}

model GroupMember {
  groupId       String
  participantId String
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([groupId, participantId])
}
