# ============================================================
# .env.example — Copy file này thành .env.local và điền giá trị thật
# KHÔNG commit .env.local lên git
# ============================================================

# --- Database (PostgreSQL qua Supabase hoặc Neon) ---

# Pooled connection (PgBouncer / Prisma Accelerate) — dùng cho runtime Next.js (Vercel serverless)
# Lấy từ: Supabase > Project Settings > Database > Connection pooling
# Hoặc: Neon > Connection Details > Pooled connection //ZC3P2t4xhbUd6o6P
DATABASE_URL="postgresql://your-user:your-password@your-pooler-host:5432/your-db?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://postgres:ZC3P2t4xhbUd6o6P@db.qzkwpobdvbmbpejxycgo.supabase.co:5432/postgres?pgbouncer=true"
# Direct connection — dùng cho `npx prisma migrate dev` và `prisma db push`
# Lấy từ: Supabase > Project Settings > Database > Direct connection
# Hoặc: Neon > Connection Details > Direct connection
DIRECT_URL="postgresql://your-user:your-password@your-direct-host:5432/your-db"

# --- NextAuth.js ---

# Secret dùng để ký JWT — sinh bằng: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# URL production của app (không có trailing slash)
# Dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (Phase 3 — Auth) ---
# Tạo tại: https://console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URIs cần thêm: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- App Config ---
# URL gốc của app (dùng để build link chia sẻ trong Server Actions)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
